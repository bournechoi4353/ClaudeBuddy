{
  "name": "clawd",
  "version": "0.1.0",
  "description": "Clawd — an 8-bit pixel crab Claude pet for your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win",
    "setup-signing": "bash scripts/setup-self-signed.sh"
  },
  "build": {
    "appId": "dev.clawd.app",
    "productName": "Clawd",
    "files": [
      "main.js",
      "preload.js",
      "agent.js",
      "tools.js",
      "platform.js",
      "spotify-auth.js",
      "google-auth.js",
      "google-secrets.js",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "build/icon.png",
      "identity": "Clawd Self-Signed",
      "extendInfo": {
        "LSUIElement": 1
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clawd"
    },
    "dmg": {
      "title": "Clawd",
      "icon": "build/icon.png",
      "contents": [
        {
          "x": 140,
          "y": 220,
          "type": "file"
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.144",
    "zod": "^4.4.3"
  }
}
